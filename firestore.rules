rules_version = '2';

// Volley Bologna Community — regole Firestore
// Pubblica con: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(id) {
      return signedIn() && uid() == id;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(uid()));
    }

    function userData(id) {
      return get(/databases/$(database)/documents/users/$(id)).data;
    }

    function isBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userData(uid()).banned == true;
    }

    function isSilenced() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userData(uid()).silencedUntil != null
        && userData(uid()).silencedUntil > request.time;
    }

    function canWrite() {
      return signedIn() && !isBanned() && !isSilenced();
    }

    function matchExists(id) {
      return exists(/databases/$(database)/documents/matches/$(id));
    }

    function matchData(id) {
      return get(/databases/$(database)/documents/matches/$(id)).data;
    }

    function isMatchOrganizer(id) {
      return signedIn() && matchExists(id) && matchData(id).organizerId == uid();
    }


    function isMatchParticipant(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/matches/$(id)/registrations/$(uid()));
    }

    // Dentro una transazione exists() vede il database com'è PRIMA: la nuova
    // iscrizione non c'è ancora. existsAfter() considera anche le scritture
    // della stessa transazione, quindi l'aggiornamento dei contatori del match
    // può essere validato insieme alla creazione della registrazione.
    function isMatchParticipantAfter(id) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/matches/$(id)/registrations/$(uid()));
    }

    function groupExists(id) {
      return exists(/databases/$(database)/documents/groups/$(id));
    }

    function groupData(id) {
      return get(/databases/$(database)/documents/groups/$(id)).data;
    }

    function isGroupOwner(id) {
      return signedIn() && groupExists(id) && groupData(id).ownerId == uid();
    }

    function isMatchGroupOwner(id) {
      return signedIn()
        && matchExists(id)
        && matchData(id).keys().hasAll(['groupId'])
        && matchData(id).groupId is string
        && groupExists(matchData(id).groupId)
        && groupData(matchData(id).groupId).ownerId == uid();
    }

    function memberExists(id) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(id)/members/$(uid()));
    }

    function membership(id) {
      return get(/databases/$(database)/documents/groups/$(id)/members/$(uid())).data;
    }

    function isActiveMember(id) {
      return memberExists(id) && membership(id).status == 'active';
    }

    // Accesso temporaneo ai dati privati dopo una segnalazione di irregolarità.
    function hasIdentityAccess(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/identityAccess/$(uid() + '_' + userId))
        && get(/databases/$(database)/documents/identityAccess/$(uid() + '_' + userId)).data.expiresAt > request.time;
    }

    function playerRequestExists(id) {
      return exists(/databases/$(database)/documents/playerRequests/$(id));
    }

    function playerRequestData(id) {
      return get(/databases/$(database)/documents/playerRequests/$(id)).data;
    }

    function isPlayerRequestOrganizer(id) {
      return signedIn() && playerRequestExists(id) && playerRequestData(id).organizerId == uid();
    }

    function applicationExists(requestId, applicantId) {
      return exists(
        /databases/$(database)/documents/playerRequests/$(requestId)/applications/$(applicantId)
      );
    }

    function applicationData(requestId, applicantId) {
      return get(
        /databases/$(database)/documents/playerRequests/$(requestId)/applications/$(applicantId)
      ).data;
    }

    function isApprovedApplicant(requestId) {
      return signedIn()
        && applicationExists(requestId, uid())
        && applicationData(requestId, uid()).status == 'approved';
    }

    // ── Profili ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin() || hasIdentityAccess(userId);
      allow list: if isAdmin();
      allow create: if isSelf(userId) && request.resource.data.uid == userId;
      allow update: if isAdmin() || (
        isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'banned', 'banReason', 'bannedAt', 'silencedUntil', 'silenceReason', 'verified', 'verificationNote'
        ])
        && (
          !('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.verificationStatus in ['none', 'submitted']
        )
      );
      allow delete: if isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId) && request.resource.data.uid == userId;
      allow update: if isAdmin() || (
        isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'bio', 'photoURL'])
      );
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if signedIn() && (isSelf(adminId) || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Impostazioni ────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false; // solo service account (cron)
    }

    // ── Match ───────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.organizerId == uid()
        && (
          !request.resource.data.keys().hasAll(['groupId'])
          || request.resource.data.groupId == null
          || (
            request.resource.data.groupId is string
            && groupExists(request.resource.data.groupId)
            && isActiveMember(request.resource.data.groupId)
          )
        )
        && (
          !request.resource.data.keys().hasAll(['visibility'])
          || request.resource.data.visibility != 'group-private'
          || (
            request.resource.data.groupId is string
            && groupExists(request.resource.data.groupId)
            && groupData(request.resource.data.groupId).visibility == 'private'
            && isActiveMember(request.resource.data.groupId)
          )
        );
      allow update: if isAdmin()
        || isMatchOrganizer(matchId)
        || (
          (isMatchParticipant(matchId) || isMatchParticipantAfter(matchId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'confirmedCount', 'waitlistCount', 'registrationSeq', 'pendingOffer', 'pendingOfferUid', 'updatedAt'
          ])
        )
        || isMatchGroupOwner(matchId);
      allow delete: if isAdmin() || isMatchOrganizer(matchId);
    }

    match /matches/{matchId}/registrations/{regId} {
      allow read: if signedIn();
      allow create: if canWrite()
        && regId == uid()
        && request.resource.data.uid == uid()
        && matchExists(matchId)
        && matchData(matchId).status == 'open'
        && request.resource.data.status in ['confirmed', 'waitlist']
        && request.resource.data.seq is int;
      allow update: if isAdmin()
        || isMatchOrganizer(matchId)
        || isMatchGroupOwner(matchId)
        || (
          regId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'offerExpiresAt'])
        )
        || (
          signedIn()
          && resource.data.status == 'waitlist'
          && request.resource.data.status == 'offered'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'offerExpiresAt'])
        );
      allow delete: if isAdmin()
        || isMatchOrganizer(matchId)
        || isMatchGroupOwner(matchId)
        || regId == uid();
    }

    match /recurringMatches/{ruleId} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.organizerId == uid()
        && (
          !request.resource.data.keys().hasAll(['groupId'])
          || request.resource.data.groupId == null
          || (
            request.resource.data.groupId is string
            && groupExists(request.resource.data.groupId)
            && isActiveMember(request.resource.data.groupId)
          )
        )
        && (
          !('frequency' in request.resource.data)
          || request.resource.data.frequency in ['weekly', 'biweekly', 'monthly']
        )
        && (
          !('approvalMode' in request.resource.data)
          || request.resource.data.approvalMode in ['auto', 'founder']
        );
      allow update: if isAdmin() || (signedIn() && resource.data.organizerId == uid());
      allow delete: if isAdmin() || (signedIn() && resource.data.organizerId == uid());
    }

    // Coda delle riproposte che richiedono l'approvazione del fondatore.
    // La creazione avviene solo dal cron con service account.
    match /recurringApprovals/{approvalId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.organizerId == uid());
      allow create: if false;
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.organizerId == uid()
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'matchId', 'reviewedAt', 'updatedAt'
          ])
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.organizerId == uid());
    }

    // ── Gruppi ──────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if canWrite()
        && (
          (request.resource.data.ownerId == uid() && request.resource.data.visibility == 'private')
          || isAdmin()
        );
      allow update: if isAdmin()
        || isGroupOwner(groupId)
        || (
          isActiveMember(groupId)
          && (
            !groupData(groupId).keys().hasAll(['editInfoPolicy'])
            || groupData(groupId).editInfoPolicy == 'all'
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'icon', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberCount', 'pendingCount', 'updatedAt'
          ])
        );
      allow delete: if isAdmin() || isGroupOwner(groupId);
    }

    match /groupSecrets/{groupId} {
      allow get: if isAdmin()
        || isGroupOwner(groupId)
        || (
          isActiveMember(groupId)
          && (
            !groupData(groupId).keys().hasAll(['addMembersPolicy'])
            || groupData(groupId).addMembersPolicy == 'all'
          )
        );
      allow list: if false;
      allow create, update: if isGroupOwner(groupId) || isAdmin();
      allow delete: if isAdmin() || isGroupOwner(groupId);
    }

    // Indice codice → gruppo. Il documento è leggibile solo conoscendo l'hash
    // del codice, quindi non permette di elencare i gruppi privati.
    match /groupInvites/{inviteHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if canWrite()
        && (
          isAdmin()
          || (
            isGroupOwner(request.resource.data.groupId)
            && request.resource.data.ownerId == uid()
          )
        );
      allow update, delete: if isAdmin()
        || (signedIn() && isGroupOwner(resource.data.groupId));
    }

    match /groupProposals/{proposalId} {
      allow read: if isAdmin() || (signedIn() && resource.data.proposedBy == uid());
      allow create: if canWrite()
        && request.resource.data.proposedBy == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.visibility == 'public'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 400;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /groups/{groupId}/members/{memberId} {
      allow read: if signedIn();

      allow create: if canWrite()
        && groupExists(groupId)
        && !(uid() in groupData(groupId).bannedUids)
        && (
          (
            memberId == uid()
            && request.resource.data.uid == uid()
            && (
              (
                groupData(groupId).ownerId == uid()
                && request.resource.data.role == 'owner'
                && request.resource.data.status == 'active'
                && request.resource.data.inviteHash == null
              )
              || (
                groupData(groupId).visibility == 'public'
                && request.resource.data.status == 'active'
                && request.resource.data.inviteHash == null
              )
              || (
                groupData(groupId).visibility == 'private'
                && request.resource.data.status == 'pending'
                && request.resource.data.inviteHash == null
              )
              || (
                groupData(groupId).visibility == 'private'
                && request.resource.data.status == 'pending'
                && request.resource.data.inviteHash != null
                && get(/databases/$(database)/documents/groupSecrets/$(groupId)).data.inviteHash == request.resource.data.inviteHash
              )
              || (
                request.resource.data.status == 'active'
                && request.resource.data.inviteHash != null
                && get(/databases/$(database)/documents/groupSecrets/$(groupId)).data.inviteHash == request.resource.data.inviteHash
              )
            )
          )
          || (
            isAdmin()
            && memberId == groupData(groupId).ownerId
            && request.resource.data.uid == groupData(groupId).ownerId
            && request.resource.data.role == 'owner'
            && request.resource.data.status == 'active'
            && request.resource.data.inviteHash == null
          )
        );

      allow update: if isAdmin()
        || isGroupOwner(groupId)
        || (
          memberId == uid()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteHash'])
          && request.resource.data.inviteHash != null
          && get(/databases/$(database)/documents/groupSecrets/$(groupId)).data.inviteHash == request.resource.data.inviteHash
        )
        || (
          memberId == uid()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'active'
          && groupData(groupId).visibility == 'public'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        );

      allow delete: if isAdmin() || isGroupOwner(groupId) || memberId == uid();
    }

    match /groups/{groupId}/messages/{messageId} {
      allow read: if isAdmin() || isActiveMember(groupId);
      allow create: if canWrite()
        && isActiveMember(groupId)
        && !(uid() in groupData(groupId).bannedUids)
        && (
          !groupData(groupId).keys().hasAll(['sendMessagesPolicy'])
          || groupData(groupId).sendMessagesPolicy == 'all'
          || isGroupOwner(groupId)
          || isAdmin()
          || (
            request.resource.data.type == 'match'
            && request.resource.data.matchId is string
            && matchExists(request.resource.data.matchId)
            && matchData(request.resource.data.matchId).organizerId == uid()
            && matchData(request.resource.data.matchId).groupId == groupId
          )
        )
        && request.resource.data.authorId == uid()
        && request.resource.data.deleted == false
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200;
      allow update: if isAdmin()
        || isGroupOwner(groupId)
        || (
          signedIn()
          && resource.data.authorId == uid()
          && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'editedAt', 'deleted', 'deletedAt', 'deletedBy'
          ])
          && (
            !('deleted' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.deleted == true
          )
        );
      allow delete: if isAdmin() || isGroupOwner(groupId);
    }

    // ── Chat generale ───────────────────────────────────────────────────────
    match /chats/general {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /chats/general/messages/{messageId} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.authorId == uid()
        && request.resource.data.deleted == false
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && (
          !('type' in request.resource.data)
          || (
            request.resource.data.type == 'match'
            && request.resource.data.matchId is string
            && matchExists(request.resource.data.matchId)
            && matchData(request.resource.data.matchId).organizerId == uid()
            && (
              !matchData(request.resource.data.matchId).keys().hasAll(['visibility'])
              || matchData(request.resource.data.matchId).visibility != 'group-private'
            )
          )
          || (
            request.resource.data.type == 'playerRequest'
            && request.resource.data.requestId is string
            && playerRequestExists(request.resource.data.requestId)
            && playerRequestData(request.resource.data.requestId).organizerId == uid()
          )
        );
      allow update: if isAdmin()
        || (
          signedIn()
          && !('type' in resource.data)
          && resource.data.authorId == uid()
          && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'editedAt', 'deleted', 'deletedAt', 'deletedBy'
          ])
          && (
            !('deleted' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.deleted == true
          )
        );
      allow delete: if isAdmin();
    }

    // ── Ricerca giocatori da gruppi privati ─────────────────────────────────
    // Il documento è visibile all'organizzatore e a chi è stato approvato.
    // Il nome del gruppo non viene copiato né mostrato nella chat generale.
    match /playerRequests/{requestId} {
      allow get: if isAdmin()
        || isPlayerRequestOrganizer(requestId)
        || isApprovedApplicant(requestId);
      allow list: if false;
      allow create: if canWrite()
        && request.resource.data.organizerId == uid()
        && groupExists(request.resource.data.groupId)
        && isGroupOwner(request.resource.data.groupId)
        && groupData(request.resource.data.groupId).visibility == 'private'
        && matchExists(request.resource.data.matchId)
        && matchData(request.resource.data.matchId).organizerId == uid()
        && request.resource.data.status == 'open';
      allow update: if isAdmin() || isPlayerRequestOrganizer(requestId);
      allow delete: if isAdmin() || isPlayerRequestOrganizer(requestId);
    }

    match /playerRequests/{requestId}/applications/{applicantId} {
      allow get: if isAdmin()
        || isPlayerRequestOrganizer(requestId)
        || isSelf(applicantId);
      allow list: if isAdmin() || isPlayerRequestOrganizer(requestId);
      allow create: if canWrite()
        && applicantId == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.status == 'pending'
        && playerRequestExists(requestId)
        && playerRequestData(requestId).status == 'open'
        && playerRequestData(requestId).organizerId != uid();
      allow update: if isAdmin() || isPlayerRequestOrganizer(requestId);
      allow delete: if isAdmin() || isSelf(applicantId);
    }

    // ── Reputazione (privata per organizzatore) ─────────────────────────────
    match /organizers/{organizerId}/trusted/{userId} {
      allow read, write: if isAdmin() || isSelf(organizerId);
    }

    match /organizers/{organizerId}/ratings/{userId} {
      allow read, write: if isAdmin() || isSelf(organizerId);
    }

    // ── Segnalazioni, accessi e contestazioni ───────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == 'open';
      allow get: if isAdmin() || (signedIn() && resource.data.reporterId == uid());
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /identityAccess/{accessId} {
      allow create: if signedIn()
        && request.resource.data.organizerId == uid()
        && exists(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.reporterId == uid()
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.targetUserId == request.resource.data.userId
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      allow read: if isAdmin() || (signedIn() && resource.data.organizerId == uid());
      allow update, delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow create: if signedIn() && request.resource.data.organizerId == uid();
      allow read, update, delete: if isAdmin();
    }

    // ── Notifiche push ──────────────────────────────────────────────────────
    // Ogni utente gestisce solo le proprie subscription (un documento per utente,
    // con una mappa di dispositivi). Le legge il Worker con il service account.
    match /pushSubscriptions/{userId} {
      allow get, create, update, delete: if isSelf(userId);
      allow list: if false;
    }

    // Coda delle notifiche: la scrivono gli utenti, la svuota solo il Worker
    // (service account, che bypassa le regole).
    match /pushJobs/{jobId} {
      allow create: if canWrite()
        && (request.resource.data.actorId == uid() || isAdmin())
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 240
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 200
        && request.resource.data.audience in ['all', 'group', 'user', 'match']
        && (
          request.resource.data.audience != 'group'
          || (
            request.resource.data.groupId is string
            && isActiveMember(request.resource.data.groupId)
          )
        )
        && (request.resource.data.audience != 'user' || request.resource.data.userId is string)
        && (request.resource.data.audience != 'match' || request.resource.data.matchId is string);
      allow read, update, delete: if false;
    }

    // Tutto il resto è chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
