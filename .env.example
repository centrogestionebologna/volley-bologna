# ── Firebase (console.firebase.google.com → Impostazioni progetto → Le tue app) ──
# Obbligatorie: senza queste l'app mostra la schermata di configurazione e non parte.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=iltuo-progetto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iltuo-progetto
VITE_FIREBASE_STORAGE_BUCKET=iltuo-progetto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opzionale: percorso del logo (default /logo.png).
# Il logo ufficiale è in public/logo.png.
VITE_LOGO_URL=/community-logo.png

# Notifiche push: chiave PUBBLICA VAPID (la stessa VAPID_PUBLIC_KEY del Worker).
# Genera la coppia con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
