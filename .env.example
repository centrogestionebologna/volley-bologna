# ── Firebase (console.firebase.google.com → Impostazioni progetto → Le tue app) ──
# Senza queste variabili l'app parte automaticamente in MODALITÀ DEMO (dati locali).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=iltuo-progetto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iltuo-progetto
VITE_FIREBASE_STORAGE_BUCKET=iltuo-progetto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Forza la modalità demo anche con Firebase configurato (utile per provare la UI).
VITE_DEMO_MODE=false
